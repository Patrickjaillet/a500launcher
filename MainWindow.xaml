<Window x:Class="A500Launcher.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:i18n="clr-namespace:A500Launcher.I18n"
        Title="{i18n:Localize app.title}" Height="600" Width="900"
        WindowStartupLocation="CenterScreen"
        WindowState="Maximized" WindowStyle="None" ResizeMode="NoResize"
        Background="{StaticResource WbBackground}"
        FontFamily="{StaticResource WbFont}"
        Cursor="{StaticResource WbCursor}"
        AllowDrop="True" Drop="OnWindowDrop" DragOver="OnDragOverAny"
        KeyDown="OnWindowKeyDown">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="26"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="24"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="{StaticResource WbWhite}" BorderBrush="{StaticResource WbBlack}" BorderThickness="0,0,0,2">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="8,0,0,0">
                <TextBlock Text="{i18n:Localize menu.workbench}" Foreground="Black" FontWeight="Bold" Margin="0,0,20,0" VerticalAlignment="Center"/>
                <Button Content="{i18n:Localize menu.floppies}" Style="{StaticResource WbIconButton}" Foreground="Black" Click="OnMenuFloppies_Click"/>
                <Button Content="{i18n:Localize menu.library}" Style="{StaticResource WbIconButton}" Foreground="Black" Click="OnMenuLibrary_Click" Margin="16,0,0,0"/>
                <Button Content="{i18n:Localize menu.settings}" Style="{StaticResource WbIconButton}" Foreground="Black" Click="OnMenuSettings_Click" Margin="16,0,0,0"/>
                <Button Content="{i18n:Localize menu.about}" Style="{StaticResource WbIconButton}" Foreground="Black" Click="OnMenuAbout_Click" Margin="16,0,0,0"/>
            </StackPanel>
        </Border>

        <Grid Grid.Row="1" Margin="20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="120"/>
                <ColumnDefinition Width="120"/>
                <ColumnDefinition Width="120"/>
                <ColumnDefinition Width="120"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" HorizontalAlignment="Center" VerticalAlignment="Top" Cursor="Hand"
                        AllowDrop="True" Drop="OnKickstartDrop" DragOver="OnDragOverRom"
                        MouseLeftButtonUp="OnPickKickstart_Click">
                <Border Width="64" Height="48" Background="{StaticResource WbWhite}" BorderBrush="{StaticResource WbBlack}" BorderThickness="2">
                    <Path Data="M8,8 L56,8 L56,40 L8,40 Z M8,8 L32,20 L56,8" Stroke="Black" StrokeThickness="2" Fill="{StaticResource WbOrange}" Stretch="Uniform" Margin="6"/>
                </Border>
                <TextBlock Text="{i18n:Localize desktop.kickstart}" Foreground="White" HorizontalAlignment="Center" Margin="0,4,0,0" TextWrapping="Wrap" TextAlignment="Center" Width="90"/>
                <TextBlock x:Name="KickstartStatusText" Foreground="#DDDDDD" FontSize="10" HorizontalAlignment="Center" TextWrapping="Wrap" Width="100"/>
            </StackPanel>

            <StackPanel Grid.Column="1" x:Name="Drive0Panel" HorizontalAlignment="Center" VerticalAlignment="Top" Cursor="Hand"
                        AllowDrop="True" Drop="OnDrive0Drop" DragOver="OnDragOverAdf"
                        MouseLeftButtonUp="OnPickFloppy0_Click">
                <StackPanel.ContextMenu>
                    <ContextMenu>
                        <MenuItem Header="{i18n:Localize menu.insert}" Click="OnDrive0Insert"/>
                        <MenuItem Header="{i18n:Localize menu.eject}" Click="OnDrive0Eject"/>
                        <MenuItem Header="{i18n:Localize menu.openFolder}" Click="OnOpenAdfFolder"/>
                        <Separator/>
                        <MenuItem x:Name="Drive0RecentMenu" Header="{i18n:Localize menu.recent}"/>
                    </ContextMenu>
                </StackPanel.ContextMenu>
                <Border Width="64" Height="48" Background="{StaticResource WbWhite}" BorderBrush="{StaticResource WbBlack}" BorderThickness="2">
                    <Canvas Width="44" Height="34" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Rectangle Fill="{StaticResource WbBlack}" Width="44" Height="34"/>
                        <Rectangle Fill="{StaticResource WbWhite}" Width="26" Height="16" Canvas.Left="9" Canvas.Top="14"/>
                        <Rectangle Fill="{StaticResource WbWhite}" Width="12" Height="9" Canvas.Left="26" Canvas.Top="3"/>
                        <Rectangle Fill="{StaticResource WbBlack}" Width="4" Height="7" Canvas.Left="30" Canvas.Top="4"/>
                    </Canvas>
                </Border>
                <TextBlock Text="{i18n:Localize desktop.df0}" Foreground="White" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                <TextBlock x:Name="Floppy0StatusText" Foreground="#DDDDDD" FontSize="10" HorizontalAlignment="Center" TextWrapping="Wrap" Width="100"/>
                <Button x:Name="Drive0EjectButton" Content="{i18n:Localize desktop.eject}" Style="{StaticResource WbIconButton}" FontSize="10"
                        Foreground="Black" Background="{StaticResource WbWindowGray}" Visibility="Collapsed" Click="OnDrive0Eject"/>
            </StackPanel>

            <StackPanel Grid.Column="2" x:Name="Drive1Panel" HorizontalAlignment="Center" VerticalAlignment="Top" Cursor="Hand"
                        AllowDrop="True" Drop="OnDrive1Drop" DragOver="OnDragOverAdf"
                        MouseLeftButtonUp="OnPickFloppy1_Click">
                <StackPanel.ContextMenu>
                    <ContextMenu>
                        <MenuItem Header="{i18n:Localize menu.insert}" Click="OnDrive1Insert"/>
                        <MenuItem Header="{i18n:Localize menu.eject}" Click="OnDrive1Eject"/>
                        <MenuItem Header="{i18n:Localize menu.openFolder}" Click="OnOpenAdfFolder"/>
                        <Separator/>
                        <MenuItem x:Name="Drive1RecentMenu" Header="{i18n:Localize menu.recent}"/>
                    </ContextMenu>
                </StackPanel.ContextMenu>
                <Border Width="64" Height="48" Background="{StaticResource WbWhite}" BorderBrush="{StaticResource WbBlack}" BorderThickness="2">
                    <Canvas Width="44" Height="34" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Rectangle Fill="{StaticResource WbBlack}" Width="44" Height="34"/>
                        <Rectangle Fill="{StaticResource WbWhite}" Width="26" Height="16" Canvas.Left="9" Canvas.Top="14"/>
                        <Rectangle Fill="{StaticResource WbWhite}" Width="12" Height="9" Canvas.Left="26" Canvas.Top="3"/>
                        <Rectangle Fill="{StaticResource WbBlack}" Width="4" Height="7" Canvas.Left="30" Canvas.Top="4"/>
                    </Canvas>
                </Border>
                <TextBlock Text="{i18n:Localize desktop.df1}" Foreground="White" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                <TextBlock x:Name="Floppy1StatusText" Foreground="#DDDDDD" FontSize="10" HorizontalAlignment="Center" TextWrapping="Wrap" Width="100"/>
                <Button x:Name="Drive1EjectButton" Content="{i18n:Localize desktop.eject}" Style="{StaticResource WbIconButton}" FontSize="10"
                        Foreground="Black" Background="{StaticResource WbWindowGray}" Visibility="Collapsed" Click="OnDrive1Eject"/>
            </StackPanel>

            <StackPanel Grid.Column="3" HorizontalAlignment="Center" VerticalAlignment="Top" Cursor="Hand"
                        MouseLeftButtonUp="OnDrawer_Click">
                <Border Width="64" Height="48" Background="{StaticResource WbWhite}" BorderBrush="{StaticResource WbBlack}" BorderThickness="2">
                    <Canvas Width="44" Height="32" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Rectangle Fill="{StaticResource WbBlack}" Width="44" Height="8" Canvas.Top="0"/>
                        <Rectangle Fill="{StaticResource WbBlack}" Width="4" Height="24" Canvas.Left="0" Canvas.Top="8"/>
                        <Rectangle Fill="{StaticResource WbBlack}" Width="4" Height="24" Canvas.Left="40" Canvas.Top="8"/>
                        <Rectangle Fill="{StaticResource WbBlack}" Width="44" Height="4" Canvas.Top="28"/>
                        <Rectangle Fill="{StaticResource WbOrange}" Width="14" Height="4" Canvas.Left="15" Canvas.Top="2"/>
                    </Canvas>
                </Border>
                <TextBlock Text="{i18n:Localize desktop.drawer}" Foreground="White" HorizontalAlignment="Center" Margin="0,4,0,0"/>
            </StackPanel>

            <Border Grid.Column="4" Width="220" Height="150" Background="{StaticResource WbWindowGray}"
                    BorderBrush="{StaticResource WbBlack}" BorderThickness="2" VerticalAlignment="Top" HorizontalAlignment="Right">
                <StackPanel Margin="12">
                    <Border Background="{StaticResource WbBlack}" Padding="4,2">
                        <TextBlock Text="{i18n:Localize boot.window.title}" Foreground="White" FontWeight="Bold"/>
                    </Border>
                    <TextBlock Text="{i18n:Localize boot.ready}" Foreground="Black" Margin="0,10,0,10" HorizontalAlignment="Center"/>
                    <Button Content="{i18n:Localize boot.button}" Style="{StaticResource WbButton}" Click="OnBoot_Click"/>
                </StackPanel>
            </Border>
        </Grid>

        <Border Grid.Row="2" Background="{StaticResource WbBlack}">
            <TextBlock x:Name="StatusBarText"
                       Foreground="{StaticResource WbOrange}" VerticalAlignment="Center" Margin="8,0,0,0" FontSize="11"/>
        </Border>
    </Grid>
</Window>
